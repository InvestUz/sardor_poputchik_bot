# ---- Local development (copy to backend/.env) ----
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
DEBUG=true
BOT_MODE=off
# To test the real bot locally: BOT_MODE=polling and set BOT_TOKEN (Mini App buttons need an https PUBLIC_URL)
BOT_TOKEN=
PUBLIC_URL=http://localhost:8000
SESSION_SECRET=dev-only-secret
FILES_DIR=./data/files
