# Copy to infra/.env on the server and fill in. Never commit the real file.

# Domain pointing to this server (A record). HTTPS certificate is issued automatically by Caddy.
DOMAIN=yolchi.example.uz

# PostgreSQL
POSTGRES_DB=yolchi
POSTGRES_USER=yolchi
POSTGRES_PASSWORD=            # openssl rand -hex 24

# Telegram (token from @BotFather)
BOT_TOKEN=
BOT_MODE=webhook
WEBHOOK_SECRET=               # openssl rand -hex 24
ADMIN_CHAT_ID=                # moderators' group id, e.g. -1001234567890 (add the bot to the group)

# Security
SESSION_SECRET=               # openssl rand -hex 32
DEBUG=false

# Misc
RUN_JOBS=true
MAX_UPLOAD_MB=10
